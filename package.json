{
  "name": "bedrock-map-builder-mcp",
  "version": "0.1.0",
  "description": "MCP server for building, editing and analysing Minecraft: Bedrock Edition maps",
  "type": "module",
  "bin": {
    "bedrock-map-builder-mcp": "dist/index.js"
  },
  "files": [
    "dist",
